{
  "name": "muraqib-core",
  "version": "1.0.0",
  "description": "Muraqib Core - Unified Developer Environment Guardian & Performance Auditor. AI-complementary DevTool for detecting security vulnerabilities, performance issues, and architecture violations in AI-generated code.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "tsx src/index.ts",
    "audit:demo": "tsx src/index.ts --path ./examples/sample-project",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "audit",
    "environment",
    "performance",
    "security",
    "ai-generated-code",
    "vulnerability-detection",
    "nodejs",
    "typescript"
  ],
  "author": "Aya Almadhon & Jenan",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@google/genai": "^2.22.0",
    "arktype": "^2.2.0",
    "axios": "^1.17.0",
    "chalk": "^5.6.2",
    "cron-parser": "^5.5.0",
    "glob": "^13.0.6",
    "ignore": "^7.0.10",
    "semver": "^7.8.2",
    "valibot": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "sharp": "^0.35.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
